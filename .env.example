# Opcjonalny adres alternatywnego katalogu quizów w formacie JSON.
VITE_QUIZ_DATA_URL=

# Publiczna konfiguracja aplikacji WWW z konsoli Firebase, w jednej linii JSON.
VITE_FIREBASE_CONFIG=

# Lokalny test z Firebase Emulator Suite. Ustaw true w .env.local w trybie dev.
VITE_FIREBASE_EMULATORS=false
